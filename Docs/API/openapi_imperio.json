{
  "openapi": "3.0.3",
  "info": {
    "title": "ImperioDelivery API",
    "description": "API REST do sistema ImperioDelivery. Firebase Auth + Firestore + Cloudinary. Porta padrão: 2580.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:2580",
      "description": "Servidor local"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID Token"
      }
    },
    "schemas": {
      "Sucesso": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object"
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ItemCarrinho": {
        "type": "object",
        "properties": {
          "produtoId": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "imagem": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "quantidade": {
            "type": "integer"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Usuário"
    },
    {
      "name": "Produtos"
    },
    {
      "name": "Carrinho"
    },
    {
      "name": "Pedidos"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Usuário"
        ],
        "summary": "Registrar cliente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email",
                  "password"
                ],
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "telefone": {
                    "type": "string"
                  },
                  "endereco": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Erro"
          }
        }
      }
    },
    "/funcionario": {
      "post": {
        "tags": [
          "Usuário"
        ],
        "summary": "Registrar funcionário (Gerente)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "telefone": {
                    "type": "string"
                  },
                  "endereco": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado"
          },
          "401": {
            "description": "Não autorizado"
          },
          "403": {
            "description": "Acesso negado"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Usuário"
        ],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token retornado"
          },
          "401": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
    "/user": {
      "put": {
        "tags": [
          "Usuário"
        ],
        "summary": "Atualizar conta",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "telefone": {
                    "type": "string"
                  },
                  "endereco": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualizado"
          },
          "401": {
            "description": "Não autorizado"
          }
        }
      },
      "delete": {
        "tags": [
          "Usuário"
        ],
        "summary": "Deletar conta",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deletado"
          },
          "401": {
            "description": "Não autorizado"
          }
        }
      }
    },
    "/produto": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "summary": "Listar todos os produtos (público)",
        "responses": {
          "200": {
            "description": "Lista de produtos"
          }
        }
      },
      "post": {
        "tags": [
          "Produtos"
        ],
        "summary": "Criar produto (Gerente)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "descricao": {
                    "type": "string"
                  },
                  "valor": {
                    "type": "number"
                  },
                  "categoria": {
                    "type": "string"
                  },
                  "imagem": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado"
          },
          "403": {
            "description": "Acesso negado"
          }
        }
      }
    },
    "/produto/{id}": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "summary": "Buscar produto por ID (público)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produto"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Produtos"
        ],
        "summary": "Atualizar produto (Gerente)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "descricao": {
                    "type": "string"
                  },
                  "valor": {
                    "type": "number"
                  },
                  "categoria": {
                    "type": "string"
                  },
                  "imagem": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualizado"
          },
          "403": {
            "description": "Acesso negado"
          }
        }
      },
      "delete": {
        "tags": [
          "Produtos"
        ],
        "summary": "Deletar produto (Gerente)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletado"
          },
          "403": {
            "description": "Acesso negado"
          }
        }
      }
    },
    "/carrinho": {
      "get": {
        "tags": [
          "Carrinho"
        ],
        "summary": "Buscar carrinho do usuário",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Carrinho"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      },
      "post": {
        "tags": [
          "Carrinho"
        ],
        "summary": "Salvar/sobrescrever carrinho",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string"
                  },
                  "itens": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ItemCarrinho"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Salvo"
          }
        }
      },
      "delete": {
        "tags": [
          "Carrinho"
        ],
        "summary": "Limpar carrinho",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Limpo"
          }
        }
      }
    },
    "/carrinho/item": {
      "post": {
        "tags": [
          "Carrinho"
        ],
        "summary": "Adicionar item ao carrinho",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCarrinho"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item adicionado"
          }
        }
      }
    },
    "/carrinho/item/{produtoId}": {
      "delete": {
        "tags": [
          "Carrinho"
        ],
        "summary": "Remover item do carrinho",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "produtoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removido"
          }
        }
      }
    },
    "/pedido": {
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Finalizar pedido",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enderecoEntrega",
                  "formaPagamento"
                ],
                "properties": {
                  "enderecoEntrega": {
                    "type": "string"
                  },
                  "formaPagamento": {
                    "type": "string"
                  },
                  "observacao": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido criado"
          },
          "400": {
            "description": "Carrinho vazio"
          }
        }
      }
    },
    "/pedido/me": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Meus pedidos",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pedidos do usuário"
          }
        }
      }
    },
    "/pedido/{id}": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Buscar pedido por ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      }
    },
    "/pedidos": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Listar todos os pedidos (Gerente)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Todos os pedidos"
          },
          "403": {
            "description": "Acesso negado"
          }
        }
      }
    },
    "/pedido/{id}/status": {
      "put": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Atualizar status do pedido (Gerente)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "pendente",
                      "em_preparo",
                      "saiu_para_entrega",
                      "entregue",
                      "cancelado"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status atualizado"
          },
          "403": {
            "description": "Acesso negado"
          }
        }
      }
    }
  }
}