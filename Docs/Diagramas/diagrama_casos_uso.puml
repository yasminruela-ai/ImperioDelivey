@startuml casos_de_uso_dominio
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Cliente" as Cliente
actor "Gerente" as Gerente
actor "Cloudinary" as Cloudinary <<system>>
actor "Sistema de IA" as IA <<system>>

rectangle "ImperioDelivery" {

  package "Carrinho e Pedidos" {
    usecase "UC01 - Realizar Pedido" as UC01
    usecase "UC03 - Acompanhar Pedido" as UC03
    usecase "UC05 - Receber Notificação de Status" as UC05
    usecase "UC13 - Visualizar Carrinho" as UC13
    usecase "UC14 - Adicionar Item ao Carrinho" as UC14
    usecase "UC15 - Remover Item do Carrinho" as UC15
    usecase "UC16 - Salvar Carrinho" as UC16
    usecase "UC17 - Limpar Carrinho" as UC17
    usecase "UC18 - Listar Todos os Pedidos" as UC18
    usecase "UC19 - Atualizar Status do Pedido" as UC19
  }

  package "Catálogo de Produtos" {
    usecase "UC04 - Visualizar Produto" as UC04
    usecase "UC09 - Listar Todos os Produtos" as UC09
    usecase "UC10 - Cadastrar Produto" as UC10
    usecase "UC11 - Atualizar Produto" as UC11
    usecase "UC12 - Remover Produto" as UC12
  }

  package "Gestão de Equipe" {
    usecase "UC21 - Cadastrar Funcionário" as UC21
  }

  package "Chat IA" {
    usecase "UC20 - Interagir com Chat IA" as UC20
  }
}

' === Cliente ===
Cliente --> UC04
Cliente --> UC09
Cliente --> UC13
Cliente --> UC14
Cliente --> UC15
Cliente --> UC16
Cliente --> UC17
Cliente --> UC01
Cliente --> UC03
Cliente --> UC05
Cliente --> UC20

' === Gerente ===
Gerente --> UC10
Gerente --> UC11
Gerente --> UC12
Gerente --> UC18
Gerente --> UC19
Gerente --> UC21

' === Includes / Extends ===
UC01 ..> UC13 : <<include>>
UC01 ..> UC17 : <<include>>
UC19 ..> UC05 : <<extend>>
UC01 ..> UC05 : <<extend>>
UC10 ..> Cloudinary : <<include>>
UC11 ..> Cloudinary : <<include>>
UC12 ..> Cloudinary : <<include>>
UC10 ..> IA : <<extend>>
UC12 ..> IA : <<extend>>

' === Herança de atores ===
Gerente --|> Cliente

@enduml
